# Prometheus for local Docker Compose.
# HOST_IP is substituted from docker/prometheus/.env at container start.

global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    cluster: taskflow
    environment: docker

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  - job_name: api-gateway
    metrics_path: /meterics
    static_configs:
      - targets: ["${HOST_IP}:5000"]
        labels:
          service: api-gateway

  - job_name: auth-service
    metrics_path: /meterics
    static_configs:
      - targets: ["${HOST_IP}:5003"]
        labels:
          service: auth-service

  - job_name: task-service
    metrics_path: /meterics
    static_configs:
      - targets: ["${HOST_IP}:5004"]
        labels:
          service: task-service

  - job_name: notification-service
    metrics_path: /meterics
    static_configs:
      - targets: ["${HOST_IP}:5005"]
        labels:
          service: notification-service

  - job_name: email-service
    metrics_path: /meterics
    static_configs:
      - targets: ["${HOST_IP}:5006"]
        labels:
          service: email-service
