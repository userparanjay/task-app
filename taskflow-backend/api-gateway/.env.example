PORT=5000
HTTP_TIMEOUT_MS=15000

AUTH_SERVICE_URL=http://localhost:5003
TASK_SERVICE_URL=http://localhost:5004
NOTIFICATION_SERVICE_URL=http://localhost:5005

# Circuit breaker (set CIRCUIT_BREAKER_ENABLED=false to disable)
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_ERROR_THRESHOLD_PERCENT=50
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000
CIRCUIT_BREAKER_VOLUME_THRESHOLD=5
CIRCUIT_BREAKER_ROLLING_WINDOW_MS=10000
