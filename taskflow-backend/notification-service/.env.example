PORT=5005
NODE_ENV=development

JWT_SECRET=change-me-in-production

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/notification_db

KAFKA_BROKER=localhost:9092
KAFKA_CLIENT_ID=notification-service
KAFKA_CONSUMER_GROUP_ID=notification-group
KAFKA_MAX_RETRY=3

REDIS_URL=redis://localhost:6380
REDIS_IDEMPOTENCY_KEY_PREFIX=notification:processed:event:
REDIS_IDEMPOTENCY_TTL_SECONDS=604800

# Logging (Loki) — use same HOST_IP as docker/prometheus/.env
HOST_IP=192.168.4.104
LOKI_PORT=3100
SERVICE_NAME=notification-service
LOG_LEVEL=info
# LOKI_URL=http://192.168.4.104:3100
