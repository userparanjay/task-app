PORT=5006
NODE_ENV=development

KAFKA_BROKER=localhost:9092
KAFKA_CLIENT_ID=email-service
KAFKA_CONSUMER_GROUP_ID=email-group-v3
KAFKA_EMAIL_RETRY_TOPIC=email.retry
KAFKA_EMAIL_DLQ_TOPIC=email.dlq
KAFKA_EMAIL_MAX_RETRY_ATTEMPTS=2
KAFKA_EMAIL_RETRY_DELAYS_MS=1000,2000

REDIS_URL=redis://localhost:6380
REDIS_IDEMPOTENCY_KEY_PREFIX=email:processed:event:
REDIS_IDEMPOTENCY_TTL_SECONDS=604800

EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_TO=recipient@example.com
